# Copy this file to .env for local development.
# Never commit .env or real credentials.

# Application
APP_NAME=MediVault API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# PostgreSQL
# Example: postgresql+psycopg://postgres:your_local_password@localhost:5432/medivault
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/medivault

# Authentication
# Generate a cryptographically random secret before running an authenticated deployment.
JWT_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173

# AWS S3 (leave blank until private storage integration is implemented)
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
